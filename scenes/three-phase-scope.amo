{
  "amo": 1,
  "meta": {
    "name": "three-phase scope",
    "author": "ali",
    "description": "The canonical signal-lab example: three sinusoidal traces (R/G/B) 120 degrees apart, sweeping left to right. G lags R by 120 degrees, B lags G by 120 degrees."
  },
  "display": {
    "gamma": 1.5,
    "spill": 0.32,
    "bloom": { "intensity": 0.6, "threshold": 0.25, "radius": 18 }
  },
  "quality": { "logicalResolution": { "width": 320, "height": 180 }, "fps": 30 },
  "timeline": { "duration": 8, "loop": true },
  "parameters": {
    "f": { "value": 2, "min": 0.25, "max": 8, "step": 0.25 },
    "amp": { "value": 0.35, "min": 0.05, "max": 0.45, "step": 0.01 },
    "s": { "value": 4, "min": 0, "max": 16, "step": 0.1 }
  },
  "scene": {
    "type": "scope",
    "rows": [
      { "type": "trace", "name": "R", "waveform": "sine", "color": "#ff0000",
        "channel": "r",
        "amplitude": 0.35, "frequency": 2, "phaseOffset": 0,
        "offset": 0.5, "sweepSpeed": 4, "thickness": 0.02, "enabled": true },
      { "type": "trace", "name": "G", "waveform": "sine", "color": "#00ff00",
        "channel": "g",
        "amplitude": 0.35, "frequency": 2, "phaseOffset": -2.0944,
        "offset": 0.5, "sweepSpeed": 4, "thickness": 0.02, "enabled": true },
      { "type": "trace", "name": "B", "waveform": "sine", "color": "#0000ff",
        "channel": "b",
        "amplitude": 0.35, "frequency": 2, "phaseOffset": -4.1888,
        "offset": 0.5, "sweepSpeed": 4, "thickness": 0.02, "enabled": true }
    ]
  }
}
