{
  "amo": 1,
  "meta": {
    "name": "three-phase oscilloscope",
    "author": "ali",
    "description": "The three-phase signals drawn as R/G/B scope traces scrolling left to right. Phase knob shifts all traces together; amplitude scales deflection."
  },
  "display": {
    "gamma": 1.5,
    "spill": 0.32,
    "bloom": { "intensity": 0.6, "threshold": 0.25, "radius": 18 }
  },
  "quality": { "logicalResolution": { "width": 320, "height": 180 }, "fps": 30 },
  "timeline": { "duration": 10, "loop": true },
  "parameters": {
    "cycles": { "value": 2, "min": 0.25, "max": 8, "step": 0.25 },
    "amplitude": { "value": 0.35, "min": 0.05, "max": 0.45, "step": 0.01 },
    "phase": { "value": 0, "min": 0, "max": 6.28318, "step": 0.01 }
  },
  "scene": {
    "type": "composite",
    "layers": [
      { "type": "color", "color": "#000000" },
      {
        "type": "curve",
        "x": "-1 + 2*p",
        "y": "amplitude*sin(tau*cycles*p - t*4)",
        "samples": 900,
        "thickness": 0.008,
        "glow": 0.85,
        "color": "#ff3040"
      },
      {
        "type": "curve",
        "x": "-1 + 2*p",
        "y": "amplitude*sin(tau*cycles*p - t*4 - tau/3 + phase)",
        "samples": 900,
        "thickness": 0.008,
        "glow": 0.85,
        "color": "#2fff60"
      },
      {
        "type": "curve",
        "x": "-1 + 2*p",
        "y": "amplitude*sin(tau*cycles*p - t*4 - 2*tau/3 + phase)",
        "samples": 900,
        "thickness": 0.008,
        "glow": 0.85,
        "color": "#3060ff"
      }
    ]
  }
}
